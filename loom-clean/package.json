{
  "name": "loom-clean",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run build && npm run preview",
    "dev": "vite --configLoader runner --host 127.0.0.1 --port 4328 --strictPort",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --host 127.0.0.1 --port 4328 --strictPort",
    "test": "vitest run --config vitest.config.ts --configLoader runner",
    "evaluate": "tsx scripts/evaluate.ts"
  },
  "dependencies": {
    "onnxruntime-web": "1.30.0",
    "pngjs": "^7.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "7.1.0",
    "vitest": "^3.2.0"
  }
}
