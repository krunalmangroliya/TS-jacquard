    "@vitejs/plugin-react": "5.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "7.1.0",
    "vitest": "^3.2.0",
    "zod": "^3.25.0"
  },
  "dependencies": {
    "@fastify/static": "8.3.0",
